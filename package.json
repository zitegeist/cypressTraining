{
  "name": "cypressTraining",
  "version": "1.0.0",
  "description": "Shared QA automation training repo — Cypress + TypeScript",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "cypress": "^15.20.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
